#!/usr/bin/env bash
#
# Reject a commit when the generated design artifacts no longer match the
# authoritative document tree:
#
#   * briefs drift from the UC/ADR text they were extracted from
#   * the registry's mechanical columns drift from the documents they index
#
# A brief is the implementation agent's design input; a registry row is the
# index other work relies on. Silent drift in either is worse than a failed
# commit, so these are gates, not warnings.
#
# Bypass is intentionally possible (git commit --no-verify) but should be
# treated as an incident, not a habit.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-commit: python3 not found; cannot verify generated artifacts" >&2
  exit 1
fi

if [ ! -f tools/gen_brief.py ] || [ ! -f tools/registry.py ]; then
  echo "pre-commit: tooling not found; run this hook from the design docs repository" >&2
  exit 1
fi

# Run every check even if an earlier one fails, so one commit reports all drift.
status=0
python3 tools/gen_brief.py --check --all || status=1
python3 tools/registry.py --check || status=1
exit "$status"
